rules_version = '2';

// Regras de segurança do Firebase Storage — ByteBank TC-04
//
// Estrutura de caminhos no bucket:
//   receipts/{userId}/{transactionId}/{filename}
//
// Princípios aplicados:
//   1. Deny-by-default: tudo é negado por padrão.
//   2. Isolamento por usuário: leitura e escrita permitidas apenas no
//      prefixo do próprio usuário autenticado (userId do caminho ==
//      UID do token).
//   3. Validação de tipo e tamanho: imagens, PDF e TXT; máximo 10 MB.
//      As condições de autenticação, ownership, tamanho e tipo formam
//      um único bloco AND — todas devem ser verdadeiras simultaneamente.
//
// ATENÇÃO: estas regras só têm efeito após serem publicadas no Firebase
// Console (Storage → Regras) ou via `firebase deploy --only storage`.

service firebase.storage {
  match /b/{bucket}/o {

    // Bloqueia todo acesso por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Recibos de transações — acesso isolado por userId no caminho.
    match /receipts/{userId}/{transactionId}/{filename} {

      // Leitura: apenas o próprio usuário autenticado.
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Criação e substituição (upload):
      //   - usuário autenticado
      //   - userId do caminho == UID do token
      //   - tamanho máximo 10 MB
      //   - content-type restrito a imagens, PDF ou texto simples
      //
      // Todas as condições são AND explícito com parênteses para evitar
      // ambiguidade de precedência entre && e ||.
      allow create, update: if (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp|heic)')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/plain'
        )
      );

      // Exclusão: apenas o próprio usuário autenticado.
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}
